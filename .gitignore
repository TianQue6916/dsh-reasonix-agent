# Python cache
__pycache__/
*.pyc

# OS files
Thumbs.db
.DS_Store

# Git submodules (ai-vibe-writing-skills is a clone)
skills/ai-vibe-writing-skills/.git/

# Node modules (if any)
node_modules/

# 凭据类（绝不入库）
dsh/local-search-token
dsh/.env
dsh/.credentials.yaml
dsh/.credentials.yml
**/keys.json
*.token

# 会话/凭据类（绝不入库，2026-09-27）
reasonix/weixin/accounts/
reasonix/desktop-shell/Network/Trust Tokens*

# 会话投影缓存（21MB / 1254 JSON，含密钥命中）与 mnemon 数据草稿，绝不入库
dsh/storages/session_projcache/
dsh/storages/mnemon-draft.json
**/session_projcache/
**/session_projcache.json

# dsh 会话 / 缓存 / 附件 / 历史备份（2026-09-28）
# sessions 源目录 291MB / 1448 个 .zstd，含完整对话内容，而本 repo 是 public
dsh/sessions/
dsh/cache/
dsh/attachments/
dsh/_backup*/
dsh/_archived*/
dsh/_dropped*/

# 本机回滚 / 冲突副本（不入库；repo 本身就是备份，备份的备份没有意义）
*.bak
*.bak-*
*.conflict.*.bak

# ds-harness-remote 设备身份与私钥（2026-09-28）
# $DSH_HOME/remote/servers/<serverHash>/{host,client}/ 下有 device.key（私钥）、
# device.json（公钥+deviceId）、trusted-peers.json（已 pin 的对端身份）。
# 本 repo 是 public，私钥一旦入库等于把「被 pin 的设备身份」交给所有人。
dsh/remote/
**/remote/servers/
**/device.key
**/trusted-peers.json
