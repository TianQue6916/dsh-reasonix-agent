# ============================================================
#  ~/.dsh 本地版本控制（2026-09-28 建立）
#  目的：让每一次手写的配置/脚本改动都有 commit 可以回指，
#        记忆与上下文才能"记得自己 git"。
#  原则：只跟踪手写的 source of truth；
#        排除 派生数据 / 运行期状态 / 凭据 / 大文件。
# ============================================================

# --- 凭据：绝不入库（哪怕这是本地仓库）---
.credentials.yaml
.credentials.yml
.env
.env.*
remote/
**/device.key
local-search-token

# --- 会话 / 缓存 / 派生物（约 600 MB，全部可重建）---
sessions/
cache/
attachments/
gate/
tmp-probe/
_backup*/
_archived*/
_dropped*/
**/node_modules/

# --- 运行期状态 ---
logs/
scratch/
*.log
*.zstd
*.lock
*.sqlite
*.db
*.sqlite3
storages/session_projcache/
storages/mnemon-draft.json
storages/plugins.json
storages/one.json
storages/*.out.csv

# --- 备份与冲突副本（repo 本身就是备份，备份的备份无意义）---
*.bak
*.bak-*
*.conflict.*
*.conflict.*.bak

# --- 单文件大块头 / 历史导入 ---
settings.yaml.imported
settings.new.yaml

# --- 2026-10-04 磁盘写入治理 ---
# 被跟踪的一整个 Edge profile 运行期 cache（1132 文件 / 29 MB，随浏览变化）
storages/tools/edge-lite/
# 构建中间产物与归档（单文件 116 MB / 51 MB，git 会反复存新版本）
storages/tools/_asar-work.asar
*.asar
.backup/
backups/*.tar.zst

# --- 运行期状态（2026-10-22 实测治理）---
# 近 300 条 auto commit 里的出现次数：dsh-headroom-ccr 156 / daemon.pid 41 /
# daemon-port 39 / thread-edges 35 / git-anchors 34 / workspace 28。
# 这些是每 20 分钟被重写的派生状态：跟踪它们让 git log 全是噪音、diff 无意义、
# 也无法回指「哪个手写改动造成了什么」。需要时可 git add -f 临时加回。
storages/dsh-headroom-ccr.json
storages/git-anchors.json
storages/workspace.json
storages/thread-edges.json
storages/thread-edges.dot
wechat-bridge/daemon.pid
wechat-bridge/daemon-port.json
