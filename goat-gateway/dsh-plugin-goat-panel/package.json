{
  "name": "@local/dsh-plugin-goat-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GOAT quota panel for the dsh web UI (session-header badge + detail popover)",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["slots"],
      "platform": "web"
    }
  }
}