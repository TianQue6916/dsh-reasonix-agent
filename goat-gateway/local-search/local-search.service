[Unit]
Description=Local Wiki Search Aggregator (PocketWiki + offline Wikipedia)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/tianque/.local/bin/local-search.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
