{"role":"user","content":"class tree =这里将定义一个操作大类\r\n    def init (value)\r\n                list A=[]\r\n            def insert (value)\r\n                add value to A\r\n            def search (value)\r\n                if value in A\r\n                    pop value from A\r\n            def delete (value)\r\n                if value in A\r\n                    remove value from A\r\n\r\n\r\n//\r\n\r\nclass TreeNode:\r\n    def __init__(self, key, value):\r\n        self.key = key\r\n        self.value = value\r\n        self.left = None\r\n        self.right = None\r\n        self.height = 1  \r\n\r\n\r\n\r\n\r\nclass BTS(tree)=深度定制各种方法\r\n    def init (key,value)\r\n                    super.init(key,value)\r\n            \r\n            \r\n            def search (key)\r\n                    super.search(key)\r\n                    \r\n\r\n    \r\n    \r\n            def insert (key,value,self,root)\r\n                    if not root\r\n                        return TreeNode(key, value)\r\n                    if key < root.key\r\n                        root.left = self.insert(key, value, self, root.left)\r\n                    elif key > root.key\r\n                        root.right = self.insert(key, value, self, root.right)\r\n                    else\r\n                        root.value = value\r\n                        return root\r\n            def left_reserve(self, root)\r\n                if not root\r\n                    return root\r\n                new_root = self.left_reserve(root.right)\r\n            \r\n\r\n            def right_reserve(self, root)\r\n                if not root or not root.left\r\n                    return root\r\n                new_root = root.left\r\n                root.left = new_root.right\r\n                new_root.right = root\r\n                root.parent = new_root\r\n                root.height = 1 + max(self.get_height(root.left), self.get_height(root.right))\r\n                root.left = root.left.right\r\n                if root.left\r\n                    root.left.parent = root\r\n                \r\n# @d 帮我在这个文件中用mind语言补全一下\r\n\r\n\r\n\r\n        \r\n        "}
